# SpaceX Orchestrator pack — Codex config example
# Activate when ChatGPT Codex Desktop / embedded CLI / `codex` on PATH is detected.
# Copy or MERGE into %USERPROFILE%\.codex\config.toml and/or <repo>\.codex\config.toml.
# MERGE RULE: never overwrite existing mcp_servers, plugins, notify, [desktop], [windows], auth.
# Only ensure [agents] keys below exist (or update spacex-managed keys). Verify against live Codex docs.
# Parent model: prefer session/UI picker — gpt-5.6-terra + medium (see 07-MODELS-MATRIX §5).
# Do NOT invent model IDs. Official: gpt-5.6-sol | gpt-5.6-terra | gpt-5.6-luna.

# Optional parent defaults (leave commented if the Desktop picker owns the thread):
# model = "gpt-5.6-terra"
# model_reasoning_effort = "medium"
# approval_policy = "on-request"
# sandbox_mode = "read-only"

[agents]
# Official key (max_threads is a legacy alias — prefer this):
max_concurrent_threads_per_session = 4
# Cheap child defaults — role TOMLs override judgment roles to terra+high:
default_subagent_model = "gpt-5.6-luna"
default_subagent_reasoning_effort = "medium"

# Roles auto-discovered from .codex/agents/*.toml when installed.
# Optional explicit pointers:
# [agents.orchestrator]
# config_file = "agents/orchestrator.toml"
