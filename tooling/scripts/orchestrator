#!/usr/bin/env bash
# SpaceX Orchestrator — cross-platform wrapper (dispatches to .ps1 or .sh)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

case "$(uname -s 2>/dev/null || echo unknown)" in
  MINGW*|MSYS*|CYGWIN*|Windows*)
    if command -v powershell.exe >/dev/null 2>&1; then
      exec powershell.exe -NoProfile -File "$SCRIPT_DIR/Orchestrator.ps1" "$@"
    fi
    if command -v pwsh >/dev/null 2>&1; then
      exec pwsh -NoProfile -File "$SCRIPT_DIR/Orchestrator.ps1" "$@"
    fi
    echo "ERROR: PowerShell required on Windows" >&2
    exit 1
    ;;
  *)
    exec "$SCRIPT_DIR/orchestrator.sh" "$@"
    ;;
esac
